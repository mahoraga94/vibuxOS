#!/usr/bin/env bash
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SELF_DIR/../.." && pwd)"
TARGET="x86_64-unknown-none"

REAL_PATH="$(
    printf '%s' "$PATH" |
        awk -v RS=: -v ORS=: -v self="$SELF_DIR" '$0 != self'
)"
REAL_PATH="${REAL_PATH%:}"

REAL_CARGO="$(PATH="$REAL_PATH" command -v cargo)"

vendor() {
    awk -F: '
        /^vendor_id[[:space:]]*:/ {
            sub(/^[[:space:]]*/, "", $2)
            print $2
            exit
        }
    ' /proc/cpuinfo
}

model_name() {
    awk -F: '
        /^model name[[:space:]]*:/ {
            sub(/^[[:space:]]*/, "", $2)
            print $2
            exit
        }
    ' /proc/cpuinfo
}

family() {
    awk -F: '
        /^cpu family[[:space:]]*:/ {
            gsub(/[[:space:]]/, "", $2)
            print $2
            exit
        }
    ' /proc/cpuinfo
}

model() {
    awk -F: '
        /^model[[:space:]]*:/ {
            gsub(/[[:space:]]/, "", $2)
            print $2
            exit
        }
    ' /proc/cpuinfo
}

target_exists() {
    rustc --target "$TARGET" --print target-cpus 2>/dev/null |
        awk 'NF {print $1}' |
        grep -Fxq "$1"
}

first_supported() {
    local x

    for x in "$@"; do
        if target_exists "$x"; then
            printf '%s\n' "$x"
            return
        fi
    done

    printf 'x86-64\n'
}

intel_target() {
    local n="${1,,}"
    local f="$(family)"
    local m="$(model)"
    local c="x86-64"

    [[ "$f" == 6 ]] || {
        printf 'x86-64\n'
        return
    }

    case "$n" in
        *haswell*) c=haswell ;;
        *broadwell*) c=broadwell ;;
        *skylake-avx512*|*"skylake xeon"*|*"skylake server"*) c=skylake-avx512 ;;
        *skylake*) c=skylake ;;
        *"kaby lake"*) c=kabylake ;;
        *"coffee lake"*) c=coffeelake ;;
        *"cannon lake"*) c=cannonlake ;;
        *"cascade lake"*) c=cascadelake ;;
        *"cooper lake"*) c=cooperlake ;;
        *"ice lake"*)
            if [[ "$n" == *xeon* || "$n" == *server* ]]; then
                c=icelake-server
            else
                c=icelake-client
            fi
            ;;
        *"tiger lake"*) c=tigerlake ;;
        *"rocket lake"*) c=rocketlake ;;
        *"alder lake"*) c=alderlake ;;
        *"raptor lake"*) c=raptorlake ;;
        *"meteor lake"*) c=meteorlake ;;
        *"lunar lake"*) c=lunarlake ;;
        *"arrow lake"*) c=arrowlake ;;
        *"sapphire rapids"*) c=sapphirerapids ;;
        *"granite rapids"*) c=graniterapids ;;
    esac

    if [[ "$c" == x86-64 ]]; then
        case "$m" in
            60|63|69|70) c=haswell ;;
            61|71|79|86) c=broadwell ;;
            78|94) c=skylake ;;
            85) c=skylake-avx512 ;;
            106|108) c=icelake-server ;;
            125|126) c=icelake-client ;;
            140|141) c=tigerlake ;;
            151|154) c=alderlake ;;
            167) c=rocketlake ;;
            183) c=raptorlake ;;
        esac
    fi

    case "$c" in
        haswell)
            first_supported haswell x86-64
            ;;
        broadwell)
            first_supported broadwell haswell x86-64
            ;;
        skylake)
            first_supported skylake broadwell haswell x86-64
            ;;
        skylake-avx512)
            first_supported skylake-avx512 skylake broadwell haswell x86-64
            ;;
        kabylake)
            first_supported kabylake skylake haswell x86-64
            ;;
        coffeelake)
            first_supported coffeelake kabylake skylake haswell x86-64
            ;;
        cannonlake)
            first_supported cannonlake coffeelake kabylake skylake haswell x86-64
            ;;
        cascadelake)
            first_supported cascadelake skylake-avx512 skylake haswell x86-64
            ;;
        cooperlake)
            first_supported cooperlake cascadelake skylake-avx512 skylake haswell x86-64
            ;;
        icelake-server)
            first_supported icelake-server cascadelake skylake-avx512 skylake x86-64
            ;;
        icelake-client)
            first_supported icelake-client cannonlake coffeelake kabylake skylake x86-64
            ;;
        tigerlake)
            first_supported tigerlake icelake-client cannonlake coffeelake skylake x86-64
            ;;
        rocketlake)
            first_supported rocketlake tigerlake icelake-client skylake x86-64
            ;;
        alderlake)
            first_supported alderlake rocketlake tigerlake icelake-client skylake x86-64
            ;;
        raptorlake)
            first_supported raptorlake alderlake rocketlake tigerlake skylake x86-64
            ;;
        meteorlake)
            first_supported meteorlake raptorlake alderlake rocketlake tigerlake x86-64
            ;;
        lunarlake)
            first_supported lunarlake meteorlake alderlake raptorlake tigerlake x86-64
            ;;
        arrowlake)
            first_supported arrowlake lunarlake meteorlake alderlake raptorlake tigerlake x86-64
            ;;
        sapphirerapids)
            first_supported sapphirerapids icelake-server skylake-avx512 skylake x86-64
            ;;
        graniterapids)
            first_supported graniterapids sapphirerapids icelake-server skylake-avx512 skylake x86-64
            ;;
        *)
            printf 'x86-64\n'
            ;;
    esac
}

detect_native() {
    local v="$(vendor)"
    local n="$(model_name)"

    case "${v,,}" in
        *authenticamd*)
            printf 'amd:native\n'
            ;;
        *genuineintel*)
            printf 'intel:%s\n' "$(intel_target "$n")"
            ;;
        *)
            printf 'generic:x86-64\n'
            ;;
    esac
}

native_flags() {
    local d="$(detect_native)"
    local cpu
    local tune=""

    case "$d" in
        amd:native)
            cpu=native
            tune=native
            ;;
        intel:*)
            cpu="${d#intel:}"
            tune="$cpu"
            ;;
        *)
            cpu=x86-64
            ;;
    esac

    printf '%s\n' \
        "-Ctarget-cpu=$cpu" \
        "-Ccode-model=kernel" \
        "-Crelocation-model=static" \
        "-Cno-redzone=yes" \
        "-Cpanic=abort" \
        "-Cdebuginfo=0" \
        "-Cforce-frame-pointers=no" \
        "-Cforce-unwind-tables=no" \
        "-Clink-dead-code=no" \
        "-Cstrip=symbols" \
        "-Clink-arg=--gc-sections" \
        "-Clink-arg=--icf=all" \
        "-Clink-arg=--build-id=none"

    if [[ -n "$tune" && "$tune" != x86-64 ]]; then
        printf '%s\n' "-Ztune-cpu=$tune"
    fi
}

me_flags() {
    printf '%s\n' \
        '--cfg=vibux_me' \
        '--cfg=vibux_h81' \
        '--cfg=vibux_haswell' \
        '--cfg=vibux_2c4t' \
        '--cfg=vibux_ddr3_1600' \
        '--cfg=vibux_ram_12g' \
        '--cfg=vibux_gpu_intel_hsw' \
        '--cfg=vibux_gpu_nvidia_kepler' \
        '--cfg=vibux_nvme_sm2263' \
        '--cfg=vibux_nvme_pcie_gen2x4' \
        '--cfg=vibux_eth_rtl810x' \
        '--cfg=vibux_wifi_rtl8188fu' \
        '--cfg=vibux_usb2_ehci' \
        '--cfg=vibux_display_1080p' \
        '--check-cfg=cfg(vibux_me)' \
        '--check-cfg=cfg(vibux_h81)' \
        '--check-cfg=cfg(vibux_haswell)' \
        '--check-cfg=cfg(vibux_2c4t)' \
        '--check-cfg=cfg(vibux_ddr3_1600)' \
        '--check-cfg=cfg(vibux_ram_12g)' \
        '--check-cfg=cfg(vibux_gpu_intel_hsw)' \
        '--check-cfg=cfg(vibux_gpu_nvidia_kepler)' \
        '--check-cfg=cfg(vibux_nvme_sm2263)' \
        '--check-cfg=cfg(vibux_nvme_pcie_gen2x4)' \
        '--check-cfg=cfg(vibux_eth_rtl810x)' \
        '--check-cfg=cfg(vibux_wifi_rtl8188fu)' \
        '--check-cfg=cfg(vibux_usb2_ehci)' \
        '--check-cfg=cfg(vibux_display_1080p)' \
        '-Ctarget-cpu=haswell' \
        '-Ztune-cpu=haswell' \
        '-Copt-level=3' \
        '-Clto=fat' \
        '-Ccodegen-units=1' \
        '-Ccode-model=kernel' \
        '-Crelocation-model=static' \
        '-Cno-redzone=yes' \
        '-Cpanic=abort' \
        '-Cdebuginfo=0' \
        '-Cforce-frame-pointers=no' \
        '-Cforce-unwind-tables=no' \
        '-Clink-dead-code=no' \
        '-Cstrip=symbols' \
        '-Clink-arg=--gc-sections' \
        '-Clink-arg=--icf=all' \
        '-Clink-arg=--build-id=none'
}

portable_flags() {
    printf '%s\n' \
        '-Ctarget-cpu=x86-64' \
        '-Ccode-model=kernel' \
        '-Crelocation-model=static' \
        '-Cno-redzone=yes' \
        '-Cpanic=abort' \
        '-Cdebuginfo=0' \
        '-Cforce-frame-pointers=no' \
        '-Cforce-unwind-tables=no' \
        '-Clink-dead-code=no' \
        '-Cstrip=symbols' \
        '-Clink-arg=--gc-sections' \
        '-Clink-arg=--icf=all' \
        '-Clink-arg=--build-id=none'
}

finalize_image() {
    local mode="$1"
    local source="$ROOT/target/vibux/vibux.img"
    local target="$ROOT/target/vibux/vibux-${mode}.img"

    if [[ ! -f "$source" ]]; then
        if [[ -f "$target" ]]; then
            printf "[VIBUX] REUSE IMAGE: %s\n" "$target"
            cp -f "$target" "$source"
            return 0
        fi
        printf "[VIBUX] ERROR: boot image was not produced: %s\n" "$source" >&2
        return 1
    fi

    cp -f "$source" "$target"
    printf "[VIBUX] IMAGE: %s\n" "$target"
}

run_mode() {
    local mode="$1"
    local profile="$2"
    local command="$3"
    shift 3

    unset RUSTFLAGS
    unset CARGO_ENCODED_RUSTFLAGS
    unset CARGO_BUILD_RUSTFLAGS

    export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-$(nproc 2>/dev/null || printf 4)}"
    export VIBUX_BUILD_MODE="$mode"
    export VIBUX_IMAGE="$ROOT/target/vibux/vibux.img"
    export VIBUX_IMAGE="$ROOT/target/vibux/vibux.img"

    local -a flags

    case "$mode" in
        me)
            mapfile -t flags < <(me_flags)
            printf '[VIBUX] ME: Intel Core i5-4570T / Haswell\n'
            ;;
        native)
            mapfile -t flags < <(native_flags)
            printf '[VIBUX] NATIVE: %s\n' "$(detect_native)"
            ;;
        portable)
            mapfile -t flags < <(portable_flags)
            printf '[VIBUX] PORTABLE: x86-64\n'
            ;;
        *)
            printf '[VIBUX] ERROR: unknown mode: %s\n' "$mode" >&2
            exit 2
            ;;
    esac

    export CARGO_TARGET_X86_64_UNKNOWN_NONE_RUSTFLAGS="$(
        printf '%s\n' "${flags[@]}" | paste -sd' ' -
    )"

    if [[ "$command" == "build" ]]; then
        "$REAL_CARGO" build --profile "$profile" "$@"
        finalize_image "$mode"
        return
    fi

    if [[ "$command" == "run" ]]; then
        local cached_image="$ROOT/target/vibux/vibux-${mode}.img"
        local generic_image="$ROOT/target/vibux/vibux.img"

        if [[ ! -f "$generic_image" && -f "$cached_image" ]]; then
            cp -f "$cached_image" "$generic_image"
            printf "[VIBUX] REUSE: %s -> %s\n" "$cached_image" "$generic_image"
        fi
        local -a cargo_args=()
        local -a program_args=()
        local after_separator=0

        for arg in "$@"; do
            if [[ "$after_separator" -eq 0 && "$arg" == "--" ]]; then
                after_separator=1
                continue
            fi

            if [[ "$after_separator" -eq 0 ]]; then
                cargo_args+=("$arg")
            else
                program_args+=("$arg")
            fi
        done

        local cached_image="$ROOT/target/vibux/vibux-${mode}.img"
        local generic_image="$ROOT/target/vibux/vibux.img"

        if [[ ! -f "$generic_image" && -f "$cached_image" ]]; then
            cp -f "$cached_image" "$generic_image"
            printf '[VIBUX] REUSE: %s -> %s\\n' "$cached_image" "$generic_image"
        fi

        "$REAL_CARGO" build --profile "$profile" "${cargo_args[@]}"

        if [[ ! -f "$generic_image" && -f "$cached_image" ]]; then
            cp -f "$cached_image" "$generic_image"
        fi

        if [[ -f "$generic_image" ]]; then
            cp -f "$generic_image" "$cached_image"
        else
            printf '[VIBUX] ERROR: no boot image available\\n' >&2
            exit 1
        fi

        local executable

        case "$profile" in
            dev)
                executable="$ROOT/target/debug/vibuxos"
                ;;
            *)
                executable="$ROOT/target/$profile/vibuxos"
                ;;
        esac

        if [[ ! -x "$executable" ]]; then
            printf '[VIBUX] ERROR: launcher not found: %s\n' "$executable" >&2
            exit 1
        fi

        exec "$executable" "${program_args[@]}"
    fi
}

case "${1:-}" in
    build|run)
        case "${2:-}" in
            me)
                run_mode me me "$1" "${@:3}"
                ;;
            native)
                run_mode native native "$1" "${@:3}"
                ;;
            portable)
                run_mode portable portable "$1" "${@:3}"
                ;;
            debug)
                run_mode native dev "$1" "${@:3}"
                ;;
            *)
                exec "$REAL_CARGO" "$@"
                ;;
        esac
        ;;
    *)
        exec "$REAL_CARGO" "$@"
        ;;
esac
